# =========================================================================
# API PACKAGE CONFIGURATION (Used for local Prisma migrations)
# Copy this file to a new file named '.env' in this exact directory.
# =========================================================================

# Used ONLY when running Prisma CLI commands directly from your local terminal.
# It targets 'localhost' because the DB port 5432 is exposed to your machine.
DATABASE_URL="postgresql://postgres_user:postgres_local_password@localhost:5432/service_tenant_erp?schema=public"