# =========================================================================
# MONOREPO ROOT CONFIGURATION (Used by Docker Compose)
# Copy this file to a new file named '.env' in this exact directory.
# =========================================================================

POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_local_password
POSTGRES_DB=service_tenant_erp

# Docker internal network connection URL
DATABASE_URL=postgresql://postgres_user:postgres_local_password@db:5432/service_tenant_erp?schema=public